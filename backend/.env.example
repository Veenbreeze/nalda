# ---------------------------------------------------------------
# NALDA USA Products CRM - Backend Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your real `.env` file.
# ---------------------------------------------------------------

# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_PREFIX=/api/v1
BUSINESS_TIMEZONE=Africa/Dar_es_Salaam

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://nalda:nalda_dev_password@localhost:5434/nalda_crm?schema=public"

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=nalda_refresh_token
REFRESH_COOKIE_SECURE=false
BCRYPT_ROUNDS=12
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

# Seed super admin (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@naldausa.co.tz
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=NALDA Super Admin

# WhatsApp Business Cloud API (Meta Graph API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_verify_token
META_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_ENABLED=true

# Cloudinary (product & media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nalda-crm

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NALDA USA Products <no-reply@naldausa.co.tz>"

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
